# =============================================
# CONFIGURAÇÕES DA SUA APLICAÇÃO
# =============================================

# Porta do servidor (Railway define automaticamente)
PORT=3001

# Segredo JWT - troque por uma string aleatória longa
JWT_SECRET=TROQUE_ISSO_POR_UMA_STRING_ALEATORIA_LONGA_E_SEGURA

# URL do frontend (Vercel)
FRONTEND_URL=http://localhost:3000

# =============================================
# MERCADO LIVRE - Obtenha em:
# https://developers.mercadolivre.com.br
# =============================================
ML_CLIENT_ID=SEU_CLIENT_ID_AQUI
ML_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
ML_REDIRECT_URI=http://localhost:3001/auth/callback

# =============================================
# BANCO DE DADOS POSTGRESQL
# Railway fornece essa URL automaticamente
# =============================================
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
